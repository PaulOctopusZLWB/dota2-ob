{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dota2-ob.local/schemas/ti2026-replay-manifest-v1.schema.json",
  "title": "TI 2026 group-stage replay manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tournament",
    "manifest_id",
    "created_at",
    "schedule_snapshot",
    "expected_game_count",
    "games",
    "counts"
  ],
  "properties": {
    "schema_version": { "const": "ti2026.replay-manifest.v1" },
    "tournament": { "const": "the-international-2026-group-stage" },
    "manifest_id": { "$ref": "#/$defs/sha256" },
    "created_at": { "$ref": "#/$defs/date_time" },
    "schedule_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "retrieved_at", "source_timestamp", "response_sha256", "swiss_series", "elimination_series", "played_maps"],
      "properties": {
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://www\\.dota2\\.com\\.cn/" },
        "retrieved_at": { "$ref": "#/$defs/date_time" },
        "source_timestamp": { "$ref": "#/$defs/date_time" },
        "response_sha256": { "$ref": "#/$defs/sha256" },
        "swiss_series": { "const": 39 },
        "elimination_series": { "const": 5 },
        "played_maps": { "const": 109 }
      }
    },
    "expected_game_count": { "const": 109 },
    "games": {
      "type": "array",
      "minItems": 109,
      "maxItems": 109,
      "items": { "$ref": "#/$defs/game" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "verified", "missing", "corrupt", "identity_mismatch", "parse_failed", "superseded", "terminal"],
      "properties": {
        "expected": { "const": 109 },
        "verified": { "$ref": "#/$defs/count" },
        "missing": { "$ref": "#/$defs/count" },
        "corrupt": { "$ref": "#/$defs/count" },
        "identity_mismatch": { "$ref": "#/$defs/count" },
        "parse_failed": { "$ref": "#/$defs/count" },
        "superseded": { "$ref": "#/$defs/count" },
        "terminal": { "$ref": "#/$defs/count" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "date_time": { "type": "string", "format": "date-time" },
    "count": { "type": "integer", "minimum": 0, "maximum": 109 },
    "terminal_status": {
      "enum": ["verified", "missing", "corrupt", "identity_mismatch", "parse_failed", "superseded"]
    },
    "workflow_status": {
      "enum": ["expected", "metadata_discovered", "acquiring", "downloaded", "validating", "verified", "missing", "corrupt", "identity_mismatch", "parse_failed", "superseded"]
    },
    "source_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_class", "url", "retrieved_at", "content_sha256"],
      "properties": {
        "source_class": { "enum": ["official_schedule", "public_match_metadata", "public_replay_metadata", "manual_client_import"] },
        "url": { "type": ["string", "null"], "format": "uri" },
        "retrieved_at": { "$ref": "#/$defs/date_time" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "team_id", "person_id", "hero_id"],
      "properties": {
        "slot": { "type": "integer", "minimum": 0, "maximum": 9 },
        "team_id": { "type": "string", "minLength": 1 },
        "person_id": { "type": "string", "minLength": 1 },
        "hero_id": { "type": "integer", "minimum": 1 }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_source",
        "acquired_at",
        "compressed_sha256",
        "compressed_bytes",
        "demo_sha256",
        "demo_bytes",
        "source2_magic",
        "parsed_match_id",
        "parsed_game_build",
        "parsed_event_time",
        "participants",
        "parser_name",
        "parser_version",
        "adapter_version",
        "facts_schema_version",
        "facts_sha256",
        "repeat_facts_sha256"
      ],
      "properties": {
        "acquisition_source": { "enum": ["approved_public_metadata", "manual_dota_client"] },
        "source_url": { "type": ["string", "null"], "format": "uri" },
        "original_filename": { "type": ["string", "null"], "maxLength": 255 },
        "acquired_at": { "$ref": "#/$defs/date_time" },
        "compressed_sha256": { "$ref": "#/$defs/sha256" },
        "compressed_bytes": { "type": "integer", "minimum": 1 },
        "demo_sha256": { "$ref": "#/$defs/sha256" },
        "demo_bytes": { "type": "integer", "minimum": 8 },
        "source2_magic": { "const": "PBDEMS2\\x00" },
        "parsed_match_id": { "type": "string", "pattern": "^[1-9][0-9]{8,}$" },
        "parsed_game_build": { "type": "integer", "minimum": 1 },
        "parsed_event_time": { "$ref": "#/$defs/date_time" },
        "radiant_team_id": { "type": "string", "minLength": 1 },
        "dire_team_id": { "type": "string", "minLength": 1 },
        "participants": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/participant" }
        },
        "parser_name": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "facts_schema_version": { "type": "string", "minLength": 1 },
        "facts_sha256": { "$ref": "#/$defs/sha256" },
        "repeat_facts_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "from", "to", "reason_code"],
      "properties": {
        "at": { "$ref": "#/$defs/date_time" },
        "from": { "type": ["string", "null"] },
        "to": { "$ref": "#/$defs/workflow_status" },
        "reason_code": { "type": "string", "minLength": 1 },
        "evidence_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "game_slot_id",
        "series_source_id",
        "game_number",
        "phase",
        "radiant_or_home_source_id",
        "dire_or_away_source_id",
        "dota_match_id",
        "status",
        "terminal",
        "reason_code",
        "source_proofs",
        "replay",
        "updated_at",
        "history"
      ],
      "properties": {
        "record_id": { "$ref": "#/$defs/sha256" },
        "game_slot_id": { "type": "string", "pattern": "^ti2026:[1-9][0-9]*:game-[1-9][0-9]*$" },
        "series_source_id": { "type": "integer", "minimum": 1 },
        "game_number": { "type": "integer", "minimum": 1, "maximum": 5 },
        "phase": { "enum": ["swiss", "elimination"] },
        "radiant_or_home_source_id": { "type": "string", "minLength": 1 },
        "dire_or_away_source_id": { "type": "string", "minLength": 1 },
        "dota_match_id": { "type": ["string", "null"], "pattern": "^[1-9][0-9]{8,}$" },
        "status": { "$ref": "#/$defs/workflow_status" },
        "terminal": { "type": "boolean" },
        "reason_code": { "type": "string", "minLength": 1 },
        "source_proofs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_proof" } },
        "replay": { "anyOf": [{ "$ref": "#/$defs/replay" }, { "type": "null" }] },
        "superseded_by_record_id": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "updated_at": { "$ref": "#/$defs/date_time" },
        "history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/history_entry" } }
      },
      "allOf": [
        {
          "if": { "properties": { "terminal": { "const": true } }, "required": ["terminal"] },
          "then": { "properties": { "status": { "$ref": "#/$defs/terminal_status" } } }
        },
        {
          "if": {
            "properties": {
              "status": { "$ref": "#/$defs/terminal_status" }
            },
            "required": ["status"]
          },
          "then": { "properties": { "terminal": { "const": true } } }
        },
        {
          "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
          "then": {
            "properties": {
              "terminal": { "const": true },
              "dota_match_id": { "type": "string", "pattern": "^[1-9][0-9]{8,}$" },
              "replay": { "$ref": "#/$defs/replay" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "superseded" } }, "required": ["status"] },
          "then": {
            "required": ["superseded_by_record_id"],
            "properties": { "superseded_by_record_id": { "$ref": "#/$defs/sha256" } }
          }
        }
      ]
    }
  }
}
